--- a/src/output/plugins/httpd/HttpdOutputPlugin.cxx	2025-01-30 00:11:53.000000000 +0800
+++ b/src/output/plugins/httpd/HttpdOutputPlugin.cxx	2025-09-11 21:33:41.000000000 +0800
@@ -60,6 +60,11 @@
 	content_type = prepared_encoder->GetMimeType();
 	if (content_type == nullptr)
 		content_type = "application/octet-stream";
+
+	/* detect whether a fixed audio format was specified in config */
+	/* Only respect legacy "format" as the fixed format key. */
+	if (const char *const cfg_format = block.GetBlockValue("format", (const char *)nullptr); cfg_format != nullptr)
+		has_config_audio_format = true;
 }
 
 inline void
@@ -188,6 +193,21 @@
 
 	const std::scoped_lock<Mutex> protect(mutex);
 
+	/* dynamically choose encoder output format based on source sample rate */
+	if (!has_config_audio_format) {
+		if (audio_format.sample_rate != 0) {
+			if (audio_format.sample_rate % 44100 == 0) {
+				audio_format.sample_rate = 44100;
+				audio_format.channels = 2;
+				audio_format.format = SampleFormat::S16;
+			} else if (audio_format.sample_rate % 48000 == 0) {
+				audio_format.sample_rate = 48000;
+				audio_format.channels = 2;
+				audio_format.format = SampleFormat::S16;
+			}
+		}
+	}
+
 	OpenEncoder(audio_format);
 
 	/* initialize other attributes */
